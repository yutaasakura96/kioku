{
  "name": "kioku",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "typecheck": "nuxt typecheck && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:schema": "vitest run --project schema",
    "test:nuxt": "vitest run --project nuxt",
    "test:e2e": "vitest run --project e2e"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "nitropack": "^2.13.4",
    "nuxt": "4.5.2",
    "pg": "8.23.0",
    "vue": "^3.5.42",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@nuxt/kit": "4.5.2",
    "@nuxt/test-utils": "^4.3.2",
    "@types/pg": "8.23.1",
    "@vue/test-utils": "^2.4.6",
    "drizzle-kit": "0.31.10",
    "happy-dom": "^20.0.11",
    "playwright-core": "^1.43.1",
    "typescript": "^5.9.3",
    "vitest": "5.0.0",
    "vue-tsc": "^3.1.1"
  }
}
